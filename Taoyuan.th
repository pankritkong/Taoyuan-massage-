<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>ระบบบัญชีร้านนวด - Massage Shop POS & Accounting</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts - Prompt -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        wood: {
                            50: '#fbf8f5',
                            100: '#f6f0ea',
                            200: '#eddccf',
                            300: '#dec2ad',
                            400: '#cca288',
                            500: '#be8668',
                            600: '#a36b50',
                            700: '#83523f',
                            800: '#6d4437',
                            900: '#4a2f26',
                            950: '#2d1b15',
                        },
                        bamboo: {
                            50: '#f3f7f4',
                            100: '#e3ece5',
                            200: '#ca9bcf',
                            300: '#a3c2ac',
                            400: '#75a181',
                            500: '#528360',
                            600: '#3e6b4a',
                            700: '#33553d',
                            800: '#2a4432',
                            900: '#24392b',
                        },
                        cream: '#FDFBF7',
                    },
                    fontFamily: {
                        sans: ['Prompt', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Prompt', sans-serif;
            background-color: #FDFBF7;
            color: #2d1b15;
            -webkit-tap-highlight-color: transparent;
        }
        /* Hide scrollbars for slick mobile view */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="bg-cream text-wood-950 pb-24 md:pb-10">

    <!-- Top Navigation Header -->
    <header class="bg-wood-900 text-cream shadow-md sticky top-0 z-30 border-b border-wood-800">
        <div class="max-w-4xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="bg-bamboo-600 p-2 rounded-xl text-white shadow-inner">
                    <i data-lucide="flower-2" class="w-6 h-6"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight tracking-wide">บัญชีร้านนวดแผนไทย</h1>
                    <p class="text-xs text-wood-300 font-light">ระบบบันทึกงาน & สรุปส่วนแบ่ง</p>
                </div>
            </div>
            <button onclick="exportToCSV()" class="flex items-center space-x-1 bg-wood-800 hover:bg-wood-700 text-wood-100 px-3 py-1.5 rounded-lg text-xs font-medium transition shadow-sm border border-wood-700">
                <i data-lucide="download" class="w-4 h-4"></i>
                <span class="hidden sm:inline">ส่งออก</span> CSV
            </button>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-4xl mx-auto px-4 py-4 space-y-6">

        <!-- Navigation Tabs (Mobile-Friendly) -->
        <div class="flex bg-wood-100 p-1 rounded-2xl shadow-inner border border-wood-200">
            <button id="tab-btn-record" onclick="switchTab('record')" class="flex-1 py-2.5 rounded-xl font-medium text-sm flex items-center justify-center space-x-2 transition-all bg-white text-wood-900 shadow-sm">
                <i data-lucide="plus-circle" class="w-4 h-4"></i>
                <span>บันทึกงานนวด</span>
            </button>
            <button id="tab-btn-summary" onclick="switchTab('summary')" class="flex-1 py-2.5 rounded-xl font-medium text-sm flex items-center justify-center space-x-2 transition-all text-wood-700 hover:text-wood-900">
                <i data-lucide="bar-chart-3" class="w-4 h-4"></i>
                <span>สรุปรายงาน</span>
            </button>
            <button id="tab-btn-history" onclick="switchTab('history')" class="flex-1 py-2.5 rounded-xl font-medium text-sm flex items-center justify-center space-x-2 transition-all text-wood-700 hover:text-wood-900">
                <i data-lucide="history" class="w-4 h-4"></i>
                <span>ประวัติรายการ</span>
            </button>
        </div>

        <!-- ================= TAB 1: บันทึกรายการนวด ================= -->
        <section id="tab-record" class="space-y-4">
            <div class="bg-white rounded-3xl p-5 shadow-sm border border-wood-200/80 space-y-5">
                <div class="border-b border-wood-100 pb-3 flex justify-between items-center">
                    <h2 class="font-semibold text-wood-900 flex items-center space-x-2">
                        <i data-lucide="clipboard-list" class="w-5 h-5 text-bamboo-600"></i>
                        <span>ลงบันทึกรอบนวดใหม่</span>
                    </h2>
                    <span id="current-date-badge" class="text-xs bg-wood-100 text-wood-800 px-2.5 py-1 rounded-full font-medium">--/--/----</span>
                </div>

                <form id="massage-form" onsubmit="handleFormSubmit(event)" class="space-y-4">
                    <!-- Date & Time Override (Optional) -->
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-medium text-wood-700 mb-1">วันที่บริการ</label>
                            <input type="date" id="record-date" required class="w-full bg-wood-50 border border-wood-200 rounded-xl px-3 py-2 text-sm text-wood-900 focus:outline-none focus:ring-2 focus:ring-bamboo-500">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-wood-700 mb-1">ชื่อหมอนวด</label>
                            <input type="text" id="masseur-name" placeholder="เช่น พี่นก, หมอเอ" required class="w-full bg-wood-50 border border-wood-200 rounded-xl px-3 py-2 text-sm text-wood-900 focus:outline-none focus:ring-2 focus:ring-bamboo-500">
                        </div>
                    </div>

                    <!-- Service Selection Buttons -->
                    <div>
                        <label class="block text-xs font-medium text-wood-700 mb-1">ประเภทนวด</label>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                            <button type="button" onclick="selectServiceCategory('foot')" id="cat-foot" class="cat-btn bg-wood-50 border-2 border-wood-200 rounded-xl py-2 px-3 text-sm font-medium text-wood-800 flex flex-col items-center justify-center space-y-1 hover:border-bamboo-500 transition">
                                <i data-lucide="footprints" class="w-5 h-5 text-bamboo-600"></i>
                                <span>นวดเท้า</span>
                            </button>
                            <button type="button" onclick="selectServiceCategory('thai')" id="cat-thai" class="cat-btn bg-wood-50 border-2 border-wood-200 rounded-xl py-2 px-3 text-sm font-medium text-wood-800 flex flex-col items-center justify-center space-y-1 hover:border-bamboo-500 transition">
                                <i data-lucide="user-check" class="w-5 h-5 text-bamboo-600"></i>
                                <span>นวดไทย</span>
                            </button>
                            <button type="button" onclick="selectServiceCategory('oil')" id="cat-oil" class="cat-btn bg-wood-50 border-2 border-wood-200 rounded-xl py-2 px-3 text-sm font-medium text-wood-800 flex flex-col items-center justify-center space-y-1 hover:border-bamboo-500 transition">
                                <i data-lucide="sparkles" class="w-5 h-5 text-bamboo-600"></i>
                                <span>นวดออยล์</span>
                            </button>
                            <button type="button" onclick="selectServiceCategory('custom')" id="cat-custom" class="cat-btn bg-wood-50 border-2 border-wood-200 rounded-xl py-2 px-3 text-sm font-medium text-wood-800 flex flex-col items-center justify-center space-y-1 hover:border-bamboo-500 transition">
                                <i data-lucide="sliders" class="w-5 h-5 text-bamboo-600"></i>
                                <span>พิเศษ/กำหนดเอง</span>
                            </button>
                        </div>
                    </div>

                    <!-- Duration Option Buttons (For Foot, Thai, Oil) -->
                    <div id="duration-selection-container" class="space-y-1">
                        <label class="block text-xs font-medium text-wood-700">ระยะเวลา</label>
                        <div class="grid grid-cols-3 gap-2">
                            <button type="button" onclick="selectDuration(1)" id="dur-1" class="dur-btn bg-wood-50 border border-wood-200 rounded-xl py-2 text-xs font-medium text-wood-800 transition">1 ชั่วโมง</button>
                            <button type="button" onclick="selectDuration(1.5)" id="dur-1.5" class="dur-btn bg-wood-50 border border-wood-200 rounded-xl py-2 text-xs font-medium text-wood-800 transition">1.5 ชั่วโมง</button>
                            <button type="button" onclick="selectDuration(2)" id="dur-2" class="dur-btn bg-wood-50 border border-wood-200 rounded-xl py-2 text-xs font-medium text-wood-800 transition">2 ชั่วโมง</button>
                        </div>
                    </div>

                    <!-- Custom Service Inputs (Appears only when 'Custom' selected) -->
                    <div id="custom-service-container" class="hidden p-3 bg-wood-50 rounded-2xl border border-wood-200 space-y-3">
                        <div>
                            <label class="block text-xs font-medium text-wood-700 mb-1">ระบุชื่อบริการพิเศษ</label>
                            <input type="text" id="custom-name" placeholder="เช่น เท้าต่อตัว, 2.5 ชม." class="w-full bg-white border border-wood-200 rounded-xl px-3 py-2 text-sm text-wood-900 focus:outline-none focus:ring-2 focus:ring-bamboo-500">
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-xs font-medium text-wood-700 mb-1">จำนวนชั่วโมง</label>
                                <input type="number" step="0.5" id="custom-hours" value="2.5" onchange="calculateCustomSplits()" class="w-full bg-white border border-wood-200 rounded-xl px-3 py-2 text-sm text-wood-900">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-wood-700 mb-1">ราคาลูกค้า (บาท)</label>
                                <input type="number" id="custom-price" placeholder="600" oninput="calculateCustomSplits()" class="w-full bg-white border border-wood-200 rounded-xl px-3 py-2 text-sm text-wood-900">
                            </div>
                        </div>
                    </div>

                    <!-- Price & Split Display / Manual Adjust -->
                    <div class="bg-wood-50/80 p-3.5 rounded-2xl border border-wood-200 space-y-2">
                        <div class="flex justify-between items-center text-xs text-wood-600">
                            <span>ราคารวมลูกค้า: <strong id="display-customer-price" class="text-sm font-semibold text-wood-900">0</strong> บาท</span>
                            <span>(<span id="display-hours">0</span> ชม.)</span>
                        </div>
                        <div class="grid grid-cols-2 gap-3 pt-1">
                            <div class="bg-white p-2.5 rounded-xl border border-wood-100 shadow-sm">
                                <label class="block text-xs text-wood-600 font-medium mb-1">ส่วนแบ่งร้าน (บาท)</label>
                                <input type="number" id="split-shop" required oninput="validateCustomSplit('shop')" class="w-full font-bold text-bamboo-700 text-base focus:outline-none bg-transparent">
                            </div>
                            <div class="bg-white p-2.5 rounded-xl border border-wood-100 shadow-sm">
                                <label class="block text-xs text-wood-600 font-medium mb-1">ส่วนแบ่งหมอ (บาท)</label>
                                <input type="number" id="split-masseur" required oninput="validateCustomSplit('masseur')" class="w-full font-bold text-wood-800 text-base focus:outline-none bg-transparent">
                            </div>
                        </div>
                    </div>

                    <!-- ค่าน้ำ (ค่าพามา/ค่าแนะนำ) Section -->
                    <div class="bg-amber-50/60 border border-amber-200/80 rounded-2xl p-3.5 space-y-3">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-2">
                                <i data-lucide="user-plus" class="w-4 h-4 text-amber-700"></i>
                                <span class="text-sm font-medium text-amber-900">มีค่าน้ำ (คนพามา/ค่าแนะนำ)</span>
                            </div>
                            <!-- Toggle Switch -->
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" id="referral-toggle" onchange="toggleReferralSection()" class="sr-only peer">
                                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-600"></div>
                            </label>
                        </div>

                        <!-- Referral Details (Appears when toggled) -->
                        <div id="referral-details" class="hidden space-y-3 pt-2 border-t border-amber-200/60">
                            <div>
                                <label class="block text-xs font-medium text-amber-800 mb-1">ชื่อคนพามา / สายงาน</label>
                                <input type="text" id="referral-name" placeholder="เช่น บอส, ไกด์เอก, แท็กซี่" class="w-full bg-white border border-amber-200 rounded-xl px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500">
                            </div>

                            <div>
                                <label class="block text-xs font-medium text-amber-800 mb-1">วิธีคำนวณค่าน้ำ (ร้านเป็นผู้จ่าย 100%)</label>
                                <div class="grid grid-cols-2 gap-2 mb-2">
                                    <button type="button" onclick="setReferralMode('hourly')" id="ref-mode-hourly" class="py-1.5 px-2 rounded-lg text-xs font-medium border border-amber-300 bg-amber-100 text-amber-900">
                                        คิดตาม ชม. (50฿/ชม.)
                                    </button>
                                    <button type="button" onclick="setReferralMode('fixed')" id="ref-mode-fixed" class="py-1.5 px-2 rounded-lg text-xs font-medium border border-amber-200 bg-white text-amber-800">
                                        ระบุจำนวนเงินเอง
                                    </button>
                                </div>
                                <div class="flex items-center space-x-2 bg-white px-3 py-2 rounded-xl border border-amber-200">
                                    <span class="text-xs text-amber-700 font-medium">จำนวนค่าน้ำ:</span>
                                    <input type="number" id="referral-fee-amount" readonly class="w-full font-bold text-amber-800 text-sm focus:outline-none bg-transparent">
                                    <span class="text-xs text-amber-700">บาท</span>
                                </div>
                                <p class="text-[11px] text-amber-700 mt-1 italic">* ค่าน้ำถูกหักจากส่วนของร้าน หมอนวดได้รับเงินเต็มจำนวนเดิม</p>
                            </div>
                        </div>
                    </div>

                    <!-- Note / Remarks -->
                    <div>
                        <label class="block text-xs font-medium text-wood-700 mb-1">หมายเหตุ (ถ้ามี)</label>
                        <input type="text" id="record-note" placeholder="เช่น ลูกค้าโอนเงิน, นวดเน้นไหล่" class="w-full bg-wood-50 border border-wood-200 rounded-xl px-3 py-2 text-sm text-wood-900 focus:outline-none focus:ring-2 focus:ring-bamboo-500">
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="w-full bg-bamboo-600 hover:bg-bamboo-700 active:bg-bamboo-800 text-white font-medium py-3.5 rounded-2xl shadow-md flex items-center justify-center space-x-2 transition text-base">
                        <i data-lucide="check-circle-2" class="w-5 h-5"></i>
                        <span>บันทึกรายการนวด</span>
                    </button>
                </form>
            </div>
        </section>

        <!-- ================= TAB 2: สรุปรายงาน ================= -->
        <section id="tab-summary" class="hidden space-y-4">
            <!-- Filter Bar -->
            <div class="bg-white p-3.5 rounded-2xl shadow-sm border border-wood-200 flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center space-x-2">
                    <i data-lucide="filter" class="w-4 h-4 text-wood-600"></i>
                    <span class="text-xs font-medium text-wood-800">ช่วงเวลา:</span>
                </div>
                <div class="flex flex-wrap gap-1">
                    <button onclick="setFilterPeriod('today')" id="filter-today" class="filter-btn px-2.5 py-1 rounded-lg text-xs font-medium bg-wood-800 text-white">วันนี้</button>
                    <button onclick="setFilterPeriod('7days')" id="filter-7days" class="filter-btn px-2.5 py-1 rounded-lg text-xs font-medium bg-wood-100 text-wood-700">7 วัน</button>
                    <button onclick="setFilterPeriod('10days')" id="filter-10days" class="filter-btn px-2.5 py-1 rounded-lg text-xs font-medium bg-wood-100 text-wood-700">10 วันล่าสุด</button>
                    <button onclick="setFilterPeriod('month')" id="filter-month" class="filter-btn px-2.5 py-1 rounded-lg text-xs font-medium bg-wood-100 text-wood-700">เดือนนี้</button>
                </div>
            </div>

            <!-- Total Stats Cards Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div class="bg-white p-3.5 rounded-2xl shadow-sm border border-wood-200">
                    <p class="text-xs text-wood-500 font-medium">ยอดขายรวม</p>
                    <p id="stat-total-revenue" class="text-lg font-bold text-wood-900 mt-0.5">0 ฿</p>
                    <p id="stat-total-jobs" class="text-[11px] text-wood-400 mt-1">0 รอบ (0 ชม.)</p>
                </div>
                <div class="bg-white p-3.5 rounded-2xl shadow-sm border border-wood-200">
                    <p class="text-xs text-bamboo-700 font-medium">ร้านรับสุทธิ</p>
                    <p id="stat-shop-net" class="text-lg font-bold text-bamboo-700 mt-0.5">0 ฿</p>
                    <p class="text-[11px] text-wood-400 mt-1">(หลังหักค่าน้ำ)</p>
                </div>
                <div class="bg-white p-3.5 rounded-2xl shadow-sm border border-wood-200">
                    <p class="text-xs text-wood-700 font-medium">จ่ายหมอนวดรวม</p>
                    <p id="stat-masseur-total" class="text-lg font-bold text-wood-800 mt-0.5">0 ฿</p>
                    <p class="text-[11px] text-wood-400 mt-1">ส่วนแบ่งหมอนวด</p>
                </div>
                <div class="bg-amber-50 p-3.5 rounded-2xl shadow-sm border border-amber-200">
                    <p class="text-xs text-amber-800 font-medium">ค่าน้ำจ่ายรวม</p>
                    <p id="stat-referral-total" class="text-lg font-bold text-amber-800 mt-0.5">0 ฿</p>
                    <p class="text-[11px] text-amber-600 mt-1">ร้านเป็นผู้จ่าย</p>
                </div>
            </div>

            <!-- Masseur Earnings Summary Table/Cards -->
            <div class="bg-white rounded-3xl p-4 shadow-sm border border-wood-200 space-y-3">
                <div class="flex justify-between items-center border-b border-wood-100 pb-2">
                    <h3 class="font-semibold text-sm text-wood-900 flex items-center space-x-1.5">
                        <i data-lucide="users" class="w-4 h-4 text-bamboo-600"></i>
                        <span>สรุปรายได้หมอนวดแต่ละคน</span>
                    </h3>
                    <span class="text-[11px] text-wood-500">แตะที่ชื่อเพื่อดูรายละเอียด</span>
                </div>
                <div id="masseur-summary-list" class="space-y-2">
                    <!-- Dynamic Rows -->
                </div>
            </div>

            <!-- Referral (ค่าน้ำ) Summary Table -->
            <div class="bg-white rounded-3xl p-4 shadow-sm border border-wood-200 space-y-3">
                <div class="flex justify-between items-center border-b border-wood-100 pb-2">
                    <h3 class="font-semibold text-sm text-amber-900 flex items-center space-x-1.5">
                        <i data-lucide="award" class="w-4 h-4 text-amber-600"></i>
                        <span>สรุปยอดค่าน้ำแยกตามคนพามา</span>
                    </h3>
                </div>
                <div id="referral-summary-list" class="space-y-2">
                    <!-- Dynamic Referral Rows -->
                </div>
            </div>
        </section>

        <!-- ================= TAB 3: ประวัติรายการ ================= -->
        <section id="tab-history" class="hidden space-y-4">
            <div class="bg-white rounded-3xl p-4 shadow-sm border border-wood-200 space-y-3">
                <div class="flex justify-between items-center border-b border-wood-100 pb-3">
                    <h3 class="font-semibold text-sm text-wood-900 flex items-center space-x-1.5">
                        <i data-lucide="history" class="w-4 h-4 text-bamboo-600"></i>
                        <span>รายการนวดทั้งหมด</span>
                    </h3>
                    <span id="history-count" class="text-xs bg-wood-100 text-wood-700 px-2 py-0.5 rounded-full">0 รายการ</span>
                </div>

                <div id="history-list" class="space-y-2.5">
                    <!-- Dynamic History Items -->
                </div>
            </div>
        </section>

    </main>

    <!-- Modal: Masseur Detail View -->
    <div id="masseur-modal" class="fixed inset-0 bg-wood-950/60 backdrop-blur-sm z-50 hidden flex items-end sm:items-center justify-center p-0 sm:p-4">
        <div class="bg-white w-full max-w-lg rounded-t-3xl sm:rounded-3xl max-h-[85vh] flex flex-col overflow-hidden shadow-2xl border border-wood-200 animate-in slide-in-from-bottom duration-200">
            <!-- Modal Header -->
            <div class="bg-wood-900 text-white p-4 flex justify-between items-center">
                <div class="flex items-center space-x-2">
                    <div class="bg-wood-700 p-2 rounded-xl">
                        <i data-lucide="user" class="w-5 h-5 text-bamboo-300"></i>
                    </div>
                    <div>
                        <h3 id="modal-masseur-name" class="font-bold text-base">ชื่อหมอนวด</h3>
                        <p id="modal-masseur-sub" class="text-xs text-wood-300">ประวัติงานนวด</p>
                    </div>
                </div>
                <button onclick="closeMasseurModal()" class="text-wood-300 hover:text-white p-1 rounded-lg">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>
            </div>

            <!-- Modal Body Stats -->
            <div class="p-4 bg-wood-50 border-b border-wood-200 grid grid-cols-3 gap-2 text-center">
                <div class="bg-white p-2 rounded-xl border border-wood-100">
                    <span class="text-[10px] text-wood-500 block">งานทั้งหมด</span>
                    <span id="modal-stat-jobs" class="font-bold text-wood-900 text-sm">0 รอบ</span>
                </div>
                <div class="bg-white p-2 rounded-xl border border-wood-100">
                    <span class="text-[10px] text-wood-500 block">ชั่วโมงรวม</span>
                    <span id="modal-stat-hours" class="font-bold text-wood-900 text-sm">0 ชม.</span>
                </div>
                <div class="bg-white p-2 rounded-xl border border-wood-100">
                    <span class="text-[10px] text-wood-500 block">เงินที่ต้องได้รับ</span>
                    <span id="modal-stat-earnings" class="font-bold text-bamboo-700 text-sm">0 ฿</span>
                </div>
            </div>

            <!-- Modal List Content -->
            <div id="modal-history-list" class="p-4 overflow-y-auto space-y-2 flex-1">
                <!-- List items inside modal -->
            </div>

            <!-- Modal Footer -->
            <div class="p-3 bg-wood-100 border-t border-wood-200 text-right">
                <button onclick="closeMasseurModal()" class="px-5 py-2 bg-wood-800 text-white text-xs font-medium rounded-xl">ปิดหน้าต่าง</button>
            </div>
        </div>
    </div>

    <!-- Notification Toast -->
    <div id="toast" class="fixed bottom-5 left-1/2 -translate-x-1/2 bg-wood-900 text-cream px-4 py-2.5 rounded-2xl shadow-xl z-50 flex items-center space-x-2 text-xs font-medium border border-wood-700 opacity-0 transition-opacity duration-300 pointer-events-none">
        <i data-lucide="check-circle" class="w-4 h-4 text-bamboo-400"></i>
        <span id="toast-message">บันทึกข้อมูลเรียบร้อยแล้ว</span>
    </div>

    <!-- Application Logic Javascript -->
    <script>
        // Standard Price Rate Rules Setup
        const RATES = {
            foot: {
                1: { price: 250, shop: 120, masseur: 130 },
                1.5: { price: 400, shop: 200, masseur: 200 },
                2: { price: 500, shop: 240, masseur: 260 }
            },
            thai: {
                1: { price: 300, shop: 150, masseur: 150 },
                1.5: { price: 450, shop: 220, masseur: 230 },
                2: { price: 500, shop: 230, masseur: 270 }
            },
            oil: {
                1: { price: 300, shop: 150, masseur: 150 },
                1.5: { price: 450, shop: 220, masseur: 230 },
                2: { price: 600, shop: 300, masseur: 300 }
            }
        };

        // App State
        let records = JSON.parse(localStorage.getItem('massage_records') || '[]');
        let selectedCategory = 'foot';
        let selectedDuration = 1;
        let referralFeeMode = 'hourly'; // 'hourly' or 'fixed'
        let currentFilterPeriod = 'today';

        // Initialize App on DOM Load
        document.addEventListener('DOMContentLoaded', () => {
            // Initialize Icons
            lucide.createIcons();

            // Set default date input to today
            const todayStr = new Date().toISOString().split('T')[0];
            document.getElementById('record-date').value = todayStr;
            document.getElementById('current-date-badge').innerText = formatDateThai(todayStr);

            // Trigger initial UI Selection
            selectServiceCategory('foot');
            renderSummary();
            renderHistory();
        });

        // Tab Switching Handler
        function switchTab(tabName) {
            document.getElementById('tab-record').classList.add('hidden');
            document.getElementById('tab-summary').classList.add('hidden');
            document.getElementById('tab-history').classList.add('hidden');

            document.getElementById('tab-btn-record').className = "flex-1 py-2.5 rounded-xl font-medium text-sm flex items-center justify-center space-x-2 transition-all text-wood-700 hover:text-wood-900";
            document.getElementById('tab-btn-summary').className = "flex-1 py-2.5 rounded-xl font-medium text-sm flex items-center justify-center space-x-2 transition-all text-wood-700 hover:text-wood-900";
            document.getElementById('tab-btn-history').className = "flex-1 py-2.5 rounded-xl font-medium text-sm flex items-center justify-center space-x-2 transition-all text-wood-700 hover:text-wood-900";

            document.getElementById(`tab-${tabName}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tab-btn-${tabName}`);
            activeBtn.className = "flex-1 py-2.5 rounded-xl font-medium text-sm flex items-center justify-center space-x-2 transition-all bg-white text-wood-900 shadow-sm";

            if (tabName === 'summary') renderSummary();
            if (tabName === 'history') renderHistory();
        }

        // Service Category Select
        function selectServiceCategory(cat) {
            selectedCategory = cat;
            document.querySelectorAll('.cat-btn').forEach(btn => {
                btn.classList.remove('border-bamboo-600', 'bg-bamboo-50', 'text-bamboo-900');
                btn.classList.add('border-wood-200', 'bg-wood-50', 'text-wood-800');
            });

            const activeBtn = document.getElementById(`cat-${cat}`);
            if (activeBtn) {
                activeBtn.classList.remove('border-wood-200', 'bg-wood-50', 'text-wood-800');
                activeBtn.classList.add('border-bamboo-600', 'bg-bamboo-50', 'text-bamboo-900');
            }

            const durContainer = document.getElementById('duration-selection-container');
            const customContainer = document.getElementById('custom-service-container');

            if (cat === 'custom') {
                durContainer.classList.add('hidden');
                customContainer.classList.remove('hidden');
                calculateCustomSplits();
            } else {
                durContainer.classList.remove('hidden');
                customContainer.classList.add('hidden');
                selectDuration(selectedDuration);
            }
        }

        // Duration Selection
        function selectDuration(hours) {
            selectedDuration = hours;
            document.querySelectorAll('.dur-btn').forEach(btn => {
                btn.classList.remove('border-bamboo-600', 'bg-bamboo-600', 'text-white');
                btn.classList.add('border-wood-200', 'bg-wood-50', 'text-wood-800');
            });

            const activeBtn = document.getElementById(`dur-${hours}`);
            if (activeBtn) {
                activeBtn.classList.remove('border-wood-200', 'bg-wood-50', 'text-wood-800');
                activeBtn.classList.add('border-bamboo-600', 'bg-bamboo-600', 'text-white');
            }

            updateCalculatedPrice();
        }

        // Update Prices based on Standard Rules
        function updateCalculatedPrice() {
            if (selectedCategory === 'custom') return;

            const rule = RATES[selectedCategory]?.[selectedDuration];
            if (rule) {
                document.getElementById('display-customer-price').innerText = rule.price;
                document.getElementById('display-hours').innerText = selectedDuration;
                document.getElementById('split-shop').value = rule.shop;
                document.getElementById('split-masseur').value = rule.masseur;
            }
            updateReferralFee();
        }

        // Custom Service Splits Calculation
        function calculateCustomSplits() {
            if (selectedCategory !== 'custom') return;

            const hours = parseFloat(document.getElementById('custom-hours').value) || 0;
            const price = parseFloat(document.getElementById('custom-price').value) || 0;

            document.getElementById('display-customer-price').innerText = price;
            document.getElementById('display-hours').innerText = hours;

            // Default 50/50 split recommendation if empty
            const half = Math.round(price / 2);
            document.getElementById('split-shop').value = half;
            document.getElementById('split-masseur').value = price - half;

            updateReferralFee();
        }

        function validateCustomSplit(changedField) {
            const totalPrice = parseFloat(document.getElementById('display-customer-price').innerText) || 0;
            let shop = parseFloat(document.getElementById('split-shop').value) || 0;
            let masseur = parseFloat(document.getElementById('split-masseur').value) || 0;

            if (changedField === 'shop') {
                document.getElementById('split-masseur').value = Math.max(0, totalPrice - shop);
            } else {
                document.getElementById('split-shop').value = Math.max(0, totalPrice - masseur);
            }
        }

        // Referral Toggle Handler
        function toggleReferralSection() {
            const isChecked = document.getElementById('referral-toggle').checked;
            const detailsDiv = document.getElementById('referral-details');

            if (isChecked) {
                detailsDiv.classList.remove('hidden');
                updateReferralFee();
            } else {
                detailsDiv.classList.add('hidden');
                document.getElementById('referral-fee-amount').value = 0;
            }
        }

        function setReferralMode(mode) {
            referralFeeMode = mode;
            const btnHourly = document.getElementById('ref-mode-hourly');
            const btnFixed = document.getElementById('ref-mode-fixed');
            const feeInput = document.getElementById('referral-fee-amount');

            if (mode === 'hourly') {
                btnHourly.className = "py-1.5 px-2 rounded-lg text-xs font-medium border border-amber-300 bg-amber-100 text-amber-900";
                btnFixed.className = "py-1.5 px-2 rounded-lg text-xs font-medium border border-amber-200 bg-white text-amber-800";
                feeInput.readOnly = true;
                updateReferralFee();
            } else {
                btnFixed.className = "py-1.5 px-2 rounded-lg text-xs font-medium border border-amber-300 bg-amber-100 text-amber-900";
                btnHourly.className = "py-1.5 px-2 rounded-lg text-xs font-medium border border-amber-200 bg-white text-amber-800";
                feeInput.readOnly = false;
                feeInput.focus();
            }
        }

        function updateReferralFee() {
            const isChecked = document.getElementById('referral-toggle').checked;
            if (!isChecked) return;

            if (referralFeeMode === 'hourly') {
                let hours = selectedDuration;
                if (selectedCategory === 'custom') {
                    hours = parseFloat(document.getElementById('custom-hours').value) || 0;
                }
                // Rate = 50 baht per hour
                const calculatedFee = hours * 50;
                document.getElementById('referral-fee-amount').value = calculatedFee;
            }
        }

        // Form Submit Handler
        function handleFormSubmit(e) {
            e.preventDefault();

            const dateVal = document.getElementById('record-date').value;
            const masseurName = document.getElementById('masseur-name').value.trim();
            const note = document.getElementById('record-note').value.trim();

            if (!masseurName) {
                showToast("กรุณากรอกชื่อหมอนวด");
                return;
            }

            let serviceTitle = "";
            let hours = selectedDuration;
            let customerPrice = parseFloat(document.getElementById('display-customer-price').innerText) || 0;

            if (selectedCategory === 'custom') {
                serviceTitle = document.getElementById('custom-name').value.trim() || 'รายการพิเศษ';
                hours = parseFloat(document.getElementById('custom-hours').value) || 0;
            } else {
                const catNames = { foot: 'นวดเท้า', thai: 'นวดไทย', oil: 'นวดออยล์' };
                serviceTitle = `${catNames[selectedCategory]} ${hours} ชม.`;
            }

            const splitShop = parseFloat(document.getElementById('split-shop').value) || 0;
            const splitMasseur = parseFloat(document.getElementById('split-masseur').value) || 0;

            // Referral Fee
            const hasReferral = document.getElementById('referral-toggle').checked;
            const referralName = hasReferral ? (document.getElementById('referral-name').value.trim() || 'ไม่ระบุชื่อ') : '';
            const referralFee = hasReferral ? (parseFloat(document.getElementById('referral-fee-amount').value) || 0) : 0;

            // Create Record Object
            const newRecord = {
                id: 'REC_' + Date.now(),
                date: dateVal,
                timestamp: new Date().getTime(),
                masseurName: masseurName,
                category: selectedCategory,
                serviceTitle: serviceTitle,
                hours: hours,
                customerPrice: customerPrice,
                splitShop: splitShop,
                splitMasseur: splitMasseur,
                hasReferral: hasReferral,
                referralName: referralName,
                referralFee: referralFee,
                note: note
            };

            // Save Record
            records.unshift(newRecord);
            saveRecords();

            // Reset Form Partially
            document.getElementById('record-note').value = '';
            document.getElementById('referral-toggle').checked = false;
            toggleReferralSection();

            showToast(`บันทึกงานของ ${masseurName} เรียบร้อยแล้ว`);
            switchTab('summary');
        }

        // Save Records to LocalStorage
        function saveRecords() {
            localStorage.setItem('massage_records', JSON.stringify(records));
        }

        // Filter Period Selection
        function setFilterPeriod(period) {
            currentFilterPeriod = period;
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.className = "filter-btn px-2.5 py-1 rounded-lg text-xs font-medium bg-wood-100 text-wood-700";
            });

            const activeBtn = document.getElementById(`filter-${period}`);
            if (activeBtn) {
                activeBtn.className = "filter-btn px-2.5 py-1 rounded-lg text-xs font-medium bg-wood-800 text-white";
            }

            renderSummary();
        }

        // Get Filtered Records Array
        function getFilteredRecords() {
            const now = new Date();
            const todayStr = now.toISOString().split('T')[0];

            return records.filter(r => {
                if (currentFilterPeriod === 'today') {
                    return r.date === todayStr;
                }
                
                const recDate = new Date(r.date);
                const diffTime = Math.abs(now - recDate);
                const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

                if (currentFilterPeriod === '7days') {
                    return diffDays <= 7;
                }
                if (currentFilterPeriod === '10days') {
                    return diffDays <= 10;
                }
                if (currentFilterPeriod === 'month') {
                    return recDate.getMonth() === now.getMonth() && recDate.getFullYear() === now.getFullYear();
                }
                return true;
            });
        }

        // Render Summary Tab
        function renderSummary() {
            const filtered = getFilteredRecords();

            let totalRev = 0;
            let totalHours = 0;
            let shopGross = 0;
            let masseurTotal = 0;
            let referralTotal = 0;

            const masseurMap = {};
            const referralMap = {};

            filtered.forEach(r => {
                totalRev += r.customerPrice;
                totalHours += r.hours;
                shopGross += r.splitShop;
                masseurTotal += r.splitMasseur;
                referralTotal += (r.referralFee || 0);

                // Masseur Aggregation
                if (!masseurMap[r.masseurName]) {
                    masseurMap[r.masseurName] = { jobs: 0, hours: 0, earnings: 0 };
                }
                masseurMap[r.masseurName].jobs += 1;
                masseurMap[r.masseurName].hours += r.hours;
                masseurMap[r.masseurName].earnings += r.splitMasseur;

                // Referral Aggregation
                if (r.hasReferral && r.referralFee > 0) {
                    const refName = r.referralName || 'ไม่ระบุชื่อ';
                    if (!referralMap[refName]) {
                        referralMap[refName] = { count: 0, totalFee: 0 };
                    }
                    referralMap[refName].count += 1;
                    referralMap[refName].totalFee += r.referralFee;
                }
            });

            // Shop Net Revenue = Gross Shop Share - Referral Fees paid by shop
            const shopNet = shopGross - referralTotal;

            // Render Stat Cards
            document.getElementById('stat-total-revenue').innerText = `${totalRev.toLocaleString()} ฿`;
            document.getElementById('stat-total-jobs').innerText = `${filtered.length} รอบ (${totalHours} ชม.)`;
            document.getElementById('stat-shop-net').innerText = `${shopNet.toLocaleString()} ฿`;
            document.getElementById('stat-masseur-total').innerText = `${masseurTotal.toLocaleString()} ฿`;
            document.getElementById('stat-referral-total').innerText = `${referralTotal.toLocaleString()} ฿`;

            // Render Masseur List
            const masseurContainer = document.getElementById('masseur-summary-list');
            masseurContainer.innerHTML = '';

            const masseurKeys = Object.keys(masseurMap);
            if (masseurKeys.length === 0) {
                masseurContainer.innerHTML = `<p class="text-xs text-wood-400 text-center py-4">ไม่มีข้อมูลในช่วงเวลานี้</p>`;
            } else {
                masseurKeys.forEach(name => {
                    const data = masseurMap[name];
                    const item = document.createElement('div');
                    item.className = "bg-wood-50/70 hover:bg-wood-100/80 p-3 rounded-2xl border border-wood-200/70 flex justify-between items-center cursor-pointer transition active:scale-[0.99]";
                    item.onclick = () => openMasseurModal(name);
                    item.innerHTML = `
                        <div class="flex items-center space-x-3">
                            <div class="bg-wood-200 text-wood-800 w-9 h-9 rounded-full flex items-center justify-center font-bold text-sm">
                                ${name.charAt(0)}
                            </div>
                            <div>
                                <h4 class="font-semibold text-sm text-wood-900">${name}</h4>
                                <p class="text-[11px] text-wood-500">${data.jobs} รอบ | ${data.hours} ชม.</p>
                            </div>
                        </div>
                        <div class="text-right flex items-center space-x-2">
                            <div>
                                <span class="text-xs text-wood-500 block">ได้ส่วนแบ่ง</span>
                                <span class="font-bold text-bamboo-700 text-sm">${data.earnings.toLocaleString()} ฿</span>
                            </div>
                            <i data-lucide="chevron-right" class="w-4 h-4 text-wood-400"></i>
                        </div>
                    `;
                    masseurContainer.appendChild(item);
                });
            }

            // Render Referral Summary List
            const refContainer = document.getElementById('referral-summary-list');
            refContainer.innerHTML = '';

            const refKeys = Object.keys(referralMap);
            if (refKeys.length === 0) {
                refContainer.innerHTML = `<p class="text-xs text-amber-700/60 text-center py-2">ไม่มีรายการค่าน้ำในช่วงเวลานี้</p>`;
            } else {
                refKeys.forEach(refName => {
                    const data = referralMap[refName];
                    const item = document.createElement('div');
                    item.className = "bg-amber-50/50 p-2.5 rounded-xl border border-amber-200/60 flex justify-between items-center";
                    item.innerHTML = `
                        <div class="flex items-center space-x-2">
                            <i data-lucide="user-check" class="w-4 h-4 text-amber-700"></i>
                            <span class="text-xs font-semibold text-amber-900">${refName}</span>
                            <span class="text-[10px] text-amber-700 bg-amber-100 px-1.5 py-0.5 rounded-full">${data.count} รายการ</span>
                        </div>
                        <span class="font-bold text-amber-800 text-xs">ยอดค่าน้ำ: ${data.totalFee.toLocaleString()} ฿</span>
                    `;
                    refContainer.appendChild(item);
                });
            }

            lucide.createIcons();
        }

        // Render History Tab
        function renderHistory() {
            const container = document.getElementById('history-list');
            container.innerHTML = '';

            document.getElementById('history-count').innerText = `${records.length} รายการ`;

            if (records.length === 0) {
                container.innerHTML = `<p class="text-xs text-wood-400 text-center py-6">ยังไม่มีประวัติการบันทึกรายการนวด</p>`;
                return;
            }

            records.forEach(r => {
                const item = document.createElement('div');
                item.className = "bg-wood-50/60 p-3 rounded-2xl border border-wood-200/70 space-y-2";
                item.innerHTML = `
                    <div class="flex justify-between items-start">
                        <div>
                            <div class="flex items-center space-x-2">
                                <span class="font-semibold text-xs text-wood-900">${r.masseurName}</span>
                                <span class="text-[10px] bg-wood-200 text-wood-800 px-2 py-0.5 rounded-md font-medium">${r.serviceTitle}</span>
                            </div>
                            <span class="text-[11px] text-wood-500">${formatDateThai(r.date)}</span>
                        </div>
                        <button onclick="deleteRecord('${r.id}')" class="text-wood-400 hover:text-red-500 p-1">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                    </div>

                    <div class="grid grid-cols-3 gap-1 pt-1 text-center bg-white p-2 rounded-xl border border-wood-100 text-xs">
                        <div>
                            <span class="text-[10px] text-wood-400 block">ราคาลูกค้า</span>
                            <span class="font-medium text-wood-900">${r.customerPrice}฿</span>
                        </div>
                        <div>
                            <span class="text-[10px] text-wood-400 block">ร้านได้</span>
                            <span class="font-medium text-bamboo-700">${r.splitShop}฿</span>
                        </div>
                        <div>
                            <span class="text-[10px] text-wood-400 block">หมอได้</span>
                            <span class="font-medium text-wood-800">${r.splitMasseur}฿</span>
                        </div>
                    </div>

                    ${r.hasReferral && r.referralFee > 0 ? `
                        <div class="text-[11px] bg-amber-50 text-amber-900 px-2.5 py-1 rounded-lg border border-amber-200 flex justify-between items-center">
                            <span>ค่าน้ำ (${r.referralName || 'คนพามา'}):</span>
                            <span class="font-bold">${r.referralFee} บาท (ร้านจ่าย)</span>
                        </div>
                    ` : ''}

                    ${r.note ? `<p class="text-[11px] text-wood-600 italic">หมายเหตุ: ${r.note}</p>` : ''}
                `;
                container.appendChild(item);
            });

            lucide.createIcons();
        }

        // Delete Record
        function deleteRecord(id) {
            if (confirm("คุณต้องการลบรายการนวดนี้ใช่หรือไม่?")) {
                records = records.filter(r => r.id !== id);
                saveRecords();
                renderHistory();
                renderSummary();
                showToast("ลบรายการเรียบร้อยแล้ว");
            }
        }

        // Open Masseur Detail Modal
        function openMasseurModal(masseurName) {
            const filtered = getFilteredRecords().filter(r => r.masseurName === masseurName);

            let totalJobs = filtered.length;
            let totalHours = 0;
            let totalEarnings = 0;

            const modalList = document.getElementById('modal-history-list');
            modalList.innerHTML = '';

            filtered.forEach(r => {
                totalHours += r.hours;
                totalEarnings += r.splitMasseur;

                const card = document.createElement('div');
                card.className = "bg-wood-50 p-2.5 rounded-xl border border-wood-200 text-xs space-y-1";
                card.innerHTML = `
                    <div class="flex justify-between font-medium text-wood-900">
                        <span>${r.serviceTitle}</span>
                        <span class="text-bamboo-700">+${r.splitMasseur} ฿</span>
                    </div>
                    <div class="flex justify-between text-[11px] text-wood-500">
                        <span>วันที่: ${formatDateThai(r.date)}</span>
                        <span>ราคาลูกค้า: ${r.customerPrice}฿</span>
                    </div>
                `;
                modalList.appendChild(card);
            });

            document.getElementById('modal-masseur-name').innerText = masseurName;
            document.getElementById('modal-masseur-sub').innerText = `รายงานสรุปช่วงเวลา ${getPeriodNameThai(currentFilterPeriod)}`;
            document.getElementById('modal-stat-jobs').innerText = `${totalJobs} รอบ`;
            document.getElementById('modal-stat-hours').innerText = `${totalHours} ชม.`;
            document.getElementById('modal-stat-earnings').innerText = `${totalEarnings.toLocaleString()} ฿`;

            document.getElementById('masseur-modal').classList.remove('hidden');
        }

        function closeMasseurModal() {
            document.getElementById('masseur-modal').classList.add('hidden');
        }

        // Export Data to CSV
        function exportToCSV() {
            if (records.length === 0) {
                showToast("ไม่มีข้อมูลให้ส่งออก");
                return;
            }

            let csvContent = "\uFEFF"; // UTF-8 BOM for Thai encoding in Excel
            csvContent += "วันที่,ชื่อหมอนวด,รายการนวด,ชั่วโมง,ราคาลูกค้า,ส่วนแบ่งร้าน,ส่วนแบ่งหมอ,มีค่าน้ำ,ชื่อคนพามา,ค่าน้ำ(ร้านจ่าย),หมายเหตุ\n";

            records.forEach(r => {
                const row = [
                    r.date,
                    `"${r.masseurName}"`,
                    `"${r.serviceTitle}"`,
                    r.hours,
                    r.customerPrice,
                    r.splitShop,
                    r.splitMasseur,
                    r.hasReferral ? "มี" : "ไม่มี",
                    `"${r.referralName || ''}"`,
                    r.referralFee || 0,
                    `"${r.note || ''}"`
                ];
                csvContent += row.join(",") + "\n";
            });

            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");
            link.setAttribute("href", url);
            link.setAttribute("download", `massage_records_${new Date().toISOString().split('T')[0]}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // Helper Utility Functions
        function formatDateThai(dateStr) {
            if (!dateStr) return '';
            const parts = dateStr.split('-');
            if (parts.length !== 3) return dateStr;
            const yearTH = parseInt(parts[0]) + 543;
            return `${parts[2]}/${parts[1]}/${yearTH}`;
        }

        function getPeriodNameThai(period) {
            const map = {
                today: 'วันนี้',
                '7days': '7 วันย้อนหลัง',
                '10days': '10 วันย้อนหลัง',
                month: 'เดือนนี้'
            };
            return map[period] || period;
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').innerText = msg;
            toast.classList.remove('opacity-0', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 2500);
        }
    </script>
</body>
</html>
